# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/web/node_modules
/.pnp
.pnp.js

# rust
/server/target

# release artefacts from `/build-binary`
/dist

# vite
/web/dist
# `web/src/api/types.ts` is deliberately NOT ignored: it is the generated
# TypeScript mirror of the wire types, and CI fails when it drifts from the
# Rust definitions, which only works if the committed copy is the reference.

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Exception: a self-signed certificate with no private key, needed by the test
# asserting that an extra CA is added to the platform roots rather than
# replacing them. The blanket rule above stays in force for everything else.
!/server/tests/fixtures/test-ca.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
docs/plans/manuscripts/*.md
# Debian packaging build products. The changelog and the unit are generated by
# the build script so their version and content have a single source of truth
# (server/Cargo.toml and deploy/inari.service); the rest is debhelper's own
# bookkeeping.
debian/changelog
debian/inari.inari.service
debian/files
debian/inari/
debian/.debhelper/
debian/*.substvars
debian/*.debhelper
debian/*.debhelper.log
debian/debhelper-build-stamp
