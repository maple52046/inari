# systemd unit for the single-binary deployment.
#
# Normally installed by the .deb (`/build-deb`). For a manual install:
#   sudo install -m 0755 inari-server /usr/bin/inari-server
#   sudo install -d -m 0755 /etc/inari
#   sudo install -m 0644 config.example.env /etc/inari/config.env
#   printf 'SESSION_SECRET=%s\n' "$(openssl rand -base64 48)" \
#     | sudo install -m 0600 /dev/stdin /etc/inari/secret.env
#   sudo install -m 0644 inari.service /etc/systemd/system/inari.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now inari

[Unit]
Description=Inari - S3-compatible object storage browser
Documentation=https://github.com/maple52046/inari
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/inari-server

# Two files, split by who owns the value. The secret is generated once at
# install time and never edited; the rest is the operator's to change, which
# keeps package upgrades from ever prompting about a file holding a secret.
#
# Both are read by systemd itself before privileges are dropped, so 0600
# root:root works even though the service runs as an unprivileged dynamic user.
# The leading `-` tolerates a manual install that never created the secret file
# and set SESSION_SECRET in config.env instead.
#
# Order matters: config.env is read second, so an explicit SESSION_SECRET there
# overrides the generated one.
EnvironmentFile=-/etc/inari/secret.env
EnvironmentFile=/etc/inari/config.env

User=inari
Group=inari
DynamicUser=yes

Restart=on-failure
RestartSec=2s
# Must exceed the server's own drain deadline, or systemd escalates to SIGKILL
# while requests are still finishing.
TimeoutStopSec=30s
KillSignal=SIGTERM

# Budget validated by measurement rather than guesswork: the process idles at
# roughly 14 MiB and stays flat through exhaustive bucket scans, because
# listings are paginated and the cleanup scan keeps only the candidates it will
# return. Raising these should follow a recorded analysis, not a stuck deploy.
MemoryHigh=128M
MemoryMax=192M
TasksMax=64

# The server writes nothing: the SPA is inside the binary and no state is kept
# on disk, so it can run against a read-only filesystem.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
