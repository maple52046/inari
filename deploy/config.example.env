# Environment for the systemd unit. Install at /etc/inari/config.env with mode
# 0640; it holds the secret that seals user credentials.

# Seals the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Address the server binds to.
#
# Loopback by default: this service speaks plain HTTP and holds sealed user
# credentials, so it is meant to sit behind a TLS-terminating reverse proxy.
# Set 0.0.0.0 only when something else provides that boundary.
HOST=127.0.0.1
PORT=3000

# Marks the process as deployed: the session cookie gets Secure by default and
# no development origin is allowed through CORS.
INARI_ENV=production

# --- The storage target -----------------------------------------------------
# These four describe where to connect and how to talk to it. None is a
# credential. Unlocked they are the connect screen's starting values, which a
# user may change.
DEFAULT_S3_ENDPOINT=https://s3.example.com
# DEFAULT_S3_REGION=us-east-1
# DEFAULT_S3_FORCE_PATH_STYLE=true
# DEFAULT_S3_SKIP_TLS_VERIFICATION=false

# Fix the target: users then supply credentials and nothing else. The connect
# screen collapses to two fields and the server refuses any other target.
#
# Recommended for any host reachable from the internet. Without it, anyone who
# can open the connect screen can point the server at any address it can reach
# -- including hosts inside your network -- and read the outcome, because the
# project was built to browse several backends.
#
# Requires DEFAULT_S3_ENDPOINT to be set; start-up fails otherwise.
# INARI_LOCK_CONNECTION=true

# URL prefix the app is served under, so a reverse proxy can forward the
# prefixed path unchanged. Unset or "/" means the root. Applied at run time, so
# one binary serves any prefix without a rebuild.
# BASE_PATH=/dashboard

# Whether the session cookie carries the Secure attribute. Defaults to true
# outside development. A Secure cookie is dropped by browsers over plaintext
# HTTP (except localhost), which makes every request look unauthenticated and
# the app appear to bounce back to /connect.
#
# Risk: setting this to false transmits sealed S3 credentials over plaintext.
# Prefer terminating TLS in front of the app.
# SESSION_COOKIE_SECURE=false

# Tokio worker threads. Unset runs the single-threaded runtime, which is the
# right default for a network-bound dashboard sharing a host with MinIO. Set to
# 2 or more only with a benchmark to justify it.
# INARI_WORKER_THREADS=2

# Largest accepted request body, in bytes. Defaults to 1 MiB.
# INARI_REQUEST_BODY_LIMIT=1048576

# Log filter, e.g. inari_server=debug,tower_http=debug
# RUST_LOG=inari_server=info

# --- Trusting a private or internal CA --------------------------------------
# The server verifies backend certificates against the OS trust store, so an
# internal CA installed there works with no further configuration:
#   sudo cp your-ca.pem /usr/local/share/ca-certificates/your-ca.crt
#   sudo update-ca-certificates
#
# To trust a single PEM without touching the OS store, point this at it. The
# certificate is added to the platform roots rather than replacing them, so
# public endpoints keep working. A missing or malformed file fails start-up.
# INARI_EXTRA_CA_CERTS=/etc/inari/ca.crt
#
# The connect screen also offers to skip verification entirely, which is
# insecure and should be a last resort.
