# Environment for the systemd unit. Install at /etc/inari/config.env with mode
# 0640; it holds the secret that seals user credentials.

# Seals the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Address the server binds to.
#
# Loopback by default: this service speaks plain HTTP and holds sealed user
# credentials, so it is meant to sit behind a TLS-terminating reverse proxy.
# Set 0.0.0.0 only when something else provides that boundary.
HOST=127.0.0.1
PORT=3000

# Marks the process as deployed: the session cookie gets Secure by default and
# no development origin is allowed through CORS.
INARI_ENV=production

# --- The storage target -----------------------------------------------------
# These four describe where to connect and how to talk to it. None is a
# credential. Unlocked they are the connect screen's starting values, which a
# user may change.
DEFAULT_S3_ENDPOINT=https://s3.example.com
# DEFAULT_S3_REGION=us-east-1
# DEFAULT_S3_FORCE_PATH_STYLE=true
# DEFAULT_S3_SKIP_TLS_VERIFICATION=false

# Fix the target: users then supply credentials and nothing else. The connect
# screen collapses to two fields and the server refuses any other target.
#
# Recommended for any host reachable from the internet. Without it, anyone who
# can open the connect screen can point the server at any address it can reach
# -- including hosts inside your network -- and read the outcome, because the
# project was built to browse several backends.
#
# Requires DEFAULT_S3_ENDPOINT to be set; start-up fails otherwise.
# INARI_LOCK_CONNECTION=true

# URL prefix the app is served under, so a reverse proxy can forward the
# prefixed path unchanged. Unset or "/" means the root. Applied at run time, so
# one binary serves any prefix without a rebuild.
# BASE_PATH=/dashboard

# Whether the session cookie carries the Secure attribute. Defaults to true
# outside development. A Secure cookie is dropped by browsers over plaintext
# HTTP (except localhost), which makes every request look unauthenticated and
# the app appear to bounce back to /connect.
#
# Risk: setting this to false transmits sealed S3 credentials over plaintext.
# Prefer terminating TLS in front of the app.
# SESSION_COOKIE_SECURE=false

# Tokio worker threads. Unset runs the single-threaded runtime, which is the
# right default for a network-bound dashboard sharing a host with MinIO. Set to
# 2 or more only with a benchmark to justify it.
# INARI_WORKER_THREADS=2

# Largest accepted request body, in bytes. Defaults to 1 MiB.
# INARI_REQUEST_BODY_LIMIT=1048576

# Log filter, e.g. inari_server=debug,tower_http=debug
# RUST_LOG=inari_server=info

# --- Shared capacity index --------------------------------------------------
# Off by default: usage figures are then scanned on demand and cached per
# browser tab, so each user pays for every scan and a reload discards it.
#
# "shared" makes the server keep one capacity index for everybody: figures are
# there on arrival, refresh themselves once stale, and are re-measured after a
# delete or a move.
#
# Requires INARI_LOCK_CONNECTION=true above. A scanner key authenticates
# against exactly one backend, so an index it builds only means anything when
# every session is pinned to that same backend. Start-up FAILS if the two
# disagree -- and with Restart=on-failure that shows up as a restart loop, so
# check `systemctl status inari` after enabling this.
# INARI_CAPACITY_INDEX=shared

# Access key the server scans with, distinct from any user's.
#
# Grant list only: s3:ListBucket and s3:ListAllMyBuckets. Do NOT grant
# s3:GetObject -- the scanner never reads object contents, so withholding it
# means a compromise of this host leaks key names and sizes rather than data.
# A ready-made wildcard policy is in the project README.
#
# Put the matching secret in /etc/inari/secret.env, not here: that file is 0600
# rather than 0640 and is not a conffile, so an upgrade never prompts about it.
#   INARI_SCANNER_SECRET_ACCESS_KEY=...
# INARI_SCANNER_ACCESS_KEY_ID=inari-scanner

# How long a measurement stays fresh. Reading a location past this serves the
# stored figures at once and refreshes them behind the response.
# INARI_CAPACITY_INDEX_TTL=5m

# The background sweep, which warms the index after a restart and keeps visited
# locations warm. The interval is the gap after the previous pass finishes, not
# a fixed period, so a long pass delays the next rather than overlapping it.
# INARI_CAPACITY_AUTOSCAN=true
# INARI_CAPACITY_AUTOSCAN_INTERVAL=15m

# Listing requests per second across all scanning. The one ceiling that bounds
# what the index costs the backend regardless of its size: 10 per second reads
# at most 10,000 keys per second. Raise it if the index is slow to catch up;
# lower it if the backend notices.
# INARI_CAPACITY_SCAN_RATE=10

# Ceilings on the index itself. Past either, a location is still measured
# exactly but is no longer broken down: the caps cost resolution, never
# accuracy. Nodes are roughly 200 bytes each, so the default is about 20 MB --
# which counts against MemoryMax in the unit file.
# INARI_CAPACITY_MAX_DEPTH=6
# INARI_CAPACITY_MAX_NODES=100000

# Which buckets the sweep covers. Unset covers every bucket the scanner can
# see; the exclusion is applied afterwards. Naming a bucket in both fails
# start-up rather than letting one silently win.
# INARI_CAPACITY_BUCKETS=photos,backups
# INARI_CAPACITY_EXCLUDE_BUCKETS=scratch

# Check a caller's access to a prefix before answering from the index.
#
# The index is filtered against the buckets each caller can list, which is all
# an S3 ListBuckets can tell us. Turn this on when users have prefix-scoped
# policies, so someone allowed only s3://data/team-a/* cannot read team-b's
# totals. Costs one small listing per read.
# INARI_CAPACITY_VERIFY_PREFIX_ACCESS=false

# --- Trusting a private or internal CA --------------------------------------
# The server verifies backend certificates against the OS trust store, so an
# internal CA installed there works with no further configuration:
#   sudo cp your-ca.pem /usr/local/share/ca-certificates/your-ca.crt
#   sudo update-ca-certificates
#
# To trust a single PEM without touching the OS store, point this at it. The
# certificate is added to the platform roots rather than replacing them, so
# public endpoints keep working. A missing or malformed file fails start-up.
# INARI_EXTRA_CA_CERTS=/etc/inari/ca.crt
#
# The connect screen also offers to skip verification entirely, which is
# insecure and should be a last resort.
