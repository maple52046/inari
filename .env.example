# Local development configuration. Copy to `.env`, which is git-ignored.
#
# `just` loads this file, and the server reads it directly at start-up when one
# is present. Values already set in the environment always win, so a systemd
# unit or a Kubernetes secret is never shadowed by a stray file.

# Seals the session cookie holding S3 credentials. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Marks the process as local. Relaxes the cookie's Secure default and allows the
# Vite dev server through CORS. Anything else is treated as production.
INARI_ENV=development

# Address the API binds to. The Vite dev server proxies /api here.
PORT=3000

# Port the Vite dev server listens on.
# WEB_PORT=5173

# --- The storage target -----------------------------------------------------
# These four describe where to connect and how to talk to it. Unlocked they are
# the connect screen's starting values, which a user may change.
DEFAULT_S3_ENDPOINT=https://s3.example.com
# DEFAULT_S3_REGION=us-east-1
# DEFAULT_S3_FORCE_PATH_STYLE=true
# DEFAULT_S3_SKIP_TLS_VERIFICATION=false

# Fix the target: users then supply credentials and nothing else. The connect
# screen collapses to two fields and the server refuses any other target.
#
# Set this on a host reachable from the internet. Without it, anyone who can
# open the connect screen can point the server at any address it can reach --
# including hosts inside your network -- and read the outcome, because the
# project was built to browse several backends. Leave it unset for local
# development, or for a build someone runs against their own storage.
#
# Requires DEFAULT_S3_ENDPOINT to be set; start-up fails otherwise.
# INARI_LOCK_CONNECTION=true

# URL prefix the whole app is served under, so a reverse proxy can forward the
# prefixed path unchanged. Unset or "/" means the root.
#
# Applied at run time: asset URLs in the bundle are relative and the server
# injects a matching <base href>, so one build serves any prefix.
# BASE_PATH=/dashboard

# Whether the session cookie carries the Secure attribute. Defaults to true
# outside development. A Secure cookie is dropped by browsers over plaintext
# HTTP (except localhost), so sign-in appears to bounce back to /connect.
#
# Risk: setting this to false transmits sealed S3 credentials over plaintext.
# Only on a trusted network; prefer terminating TLS in front of the app.
# SESSION_COOKIE_SECURE=false

# Origin the Vite dev server runs on, allowed through the cross-origin guard.
# Only read in development.
# INARI_DEV_ORIGIN=http://localhost:5173

# Tokio worker threads. Unset runs the single-threaded runtime, the right
# default for a network-bound dashboard sharing a host with MinIO.
# INARI_WORKER_THREADS=2

# Largest accepted request body, in bytes. Defaults to 1 MiB.
# INARI_REQUEST_BODY_LIMIT=1048576

# Log filter.
# RUST_LOG=inari_server=debug,tower_http=debug

# --- Shared capacity index --------------------------------------------------
# Off by default, which is today's behaviour: usage figures are scanned on
# demand and cached per browser tab.
#
# "shared" makes the server keep one capacity index for everybody: figures
# survive a reload, are visible to every session, refresh themselves when a
# reader finds them stale, and are re-measured after a delete or a move.
#
# It requires INARI_LOCK_CONNECTION=true. A scanner key authenticates against
# exactly one backend, so an index it builds only means anything when every
# session is pinned to that same backend. Start-up fails if the two disagree.
# INARI_CAPACITY_INDEX=shared

# Credentials the server scans with, distinct from any user's.
#
# Grant list only: s3:ListBucket and s3:ListAllMyBuckets. Do NOT grant
# s3:GetObject -- the scanner never reads object contents, and withholding it
# means a compromise of this host leaks key names and sizes rather than data.
# The README has a ready-made wildcard policy under "Scanner key 的 policy".
#
# Each also accepts a _FILE variant naming a file to read, so a Kubernetes
# Secret or a systemd credential can be mounted instead of inlined.
# INARI_SCANNER_ACCESS_KEY_ID=inari-scanner
# INARI_SCANNER_SECRET_ACCESS_KEY=...
# INARI_SCANNER_SECRET_ACCESS_KEY_FILE=/run/secrets/inari-scanner

# How long a measurement stays fresh. Reading a location past this serves the
# stored figures at once and refreshes them behind the response.
# INARI_CAPACITY_INDEX_TTL=5m

# The background sweep, which warms the index after a restart and keeps visited
# locations warm. Its interval is the gap after the previous pass finishes, not
# a fixed period, so a long pass delays the next rather than overlapping it.
# INARI_CAPACITY_AUTOSCAN=true
# INARI_CAPACITY_AUTOSCAN_INTERVAL=15m

# Listing requests per second across all scanning. This is the one ceiling that
# bounds what the index costs the backend regardless of its size: 10 per second
# reads at most 10,000 keys per second. Raise it if the index is slow to catch
# up; lower it if the backend notices.
# INARI_CAPACITY_SCAN_RATE=10

# Ceilings on the index itself. Past either, a location is still measured
# exactly but is no longer broken down: the caps cost resolution, never
# accuracy. Depth counts prefix levels; nodes are roughly 200 bytes each.
# INARI_CAPACITY_MAX_DEPTH=6
# INARI_CAPACITY_MAX_NODES=100000

# Which buckets the sweep covers. Unset covers every bucket the scanner can
# see; the exclusion is applied afterwards. Naming a bucket in both fails
# start-up rather than letting one silently win.
# INARI_CAPACITY_BUCKETS=photos,backups
# INARI_CAPACITY_EXCLUDE_BUCKETS=scratch

# Check a caller's access to a prefix before answering from the index.
#
# The index is filtered against the buckets the caller can list, which is all an
# S3 ListBuckets can tell us. Turn this on when users have prefix-scoped
# policies, so someone allowed only s3://data/team-a/* cannot read team-b's
# totals. Costs one small listing per read.
# INARI_CAPACITY_VERIFY_PREFIX_ACCESS=false

# --- Integration tests ------------------------------------------------------
# `just minio-up` starts a throwaway MinIO on :9100. The server integration
# suite skips itself unless all three are set.
# MINIO_DEV_PASSWORD=pick-any-throwaway-password
# INARI_TEST_S3_ENDPOINT=http://127.0.0.1:9100
# INARI_TEST_S3_ACCESS_KEY=inari-dev
# INARI_TEST_S3_SECRET_KEY=pick-any-throwaway-password

# --- Trusting a private or internal CA --------------------------------------
# The server verifies backend certificates against the OS trust store, so an
# internal CA installed there works with no further configuration:
#   sudo cp your-ca.pem /usr/local/share/ca-certificates/your-ca.crt
#   sudo update-ca-certificates
#
# To trust a single PEM without touching the OS store, point this at it. The
# certificate is added to the platform roots rather than replacing them, so
# public endpoints keep working. A missing or malformed file fails start-up.
# INARI_EXTRA_CA_CERTS=/path/to/ca.pem
#
# The connect screen also offers to skip verification, which is insecure and
# should be a last resort.
